{
    "name": "imettool/imet-core",
    "description": "Imet core package",
    "version": "3.1.8",
    "authors": [
        {
            "name": "Andrea Marelli",
            "email": "andrea.marelli@ext.ec.europa.eu"
        },
        {
            "name": "Panagiotis Politopoulos",
            "email": "panagiotis.politopoulos@ext.ec.europa.eu"
        }
    ],
    "license": "EUPL-1.2",
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "akp/modular-forms": "3.5.3.1"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0"
    },
    "repositories": {
        "akp/modular-forms": {
            "type": "vcs",
            "url": "https://code.europa.eu/akp/modular-forms"
        }
    },
    "autoload": {
        "psr-4": {
            "ImetCore\\": "src"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "ImetCore\\ServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-update-cmd": [
            "php notice-generator.php"
        ]
    },
    "archive": {
        "exclude": [
            ".run",
            "dev",
            "docker",
            ".dockerignore",
            ".gitattributes",
            ".gitignore",
            "docker-compose.yml",
            "notice-generator.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
