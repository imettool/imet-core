{
    "name": "andreamarelli/imet-core",
    "description": "Imet core package",
    "version": "3.0.2",
    "authors": [
        {
            "name": "Andrea Marelli",
            "email": "andrea.marelli@ext.ec.europa.eu"
        },
        {
            "name": "Panagiotis Politopoulos",
            "email": "panagiotis.politopoulos@ext.ec.europa.eu"
        }
    ],
    "license": "EUPL-1.2",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "andreamarelli/modular-forms": "^3.4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0"
    },
    "repositories": {
        "andreamarelli/modular-forms": {
            "type": "vcs",
            "url": "https://github.com/andreamarelli/modular-forms"
        }
    },
    "autoload": {
        "psr-4": {
            "ImetCore\\": "src"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "ImetCore\\ServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-update-cmd": [
            "php notice-generator.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
