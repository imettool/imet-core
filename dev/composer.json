{
    "type": "project",
    "description": "Development environment for imet-core package",
    "require-dev": {
        "php": ">=8.4",
        "ext-pcntl": "*",
        "ext-sockets": "*",
        "ext-zip": "*",
        "andreamarelli/imet-core": "*",
        "barryvdh/laravel-ide-helper": "3.6.0",
        "driftingly/rector-laravel": "^2.0",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "*",
        "laravel/framework": "^12.0",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "opcodesio/log-viewer": "^3.19",
        "pestphp/pest": "^4.1",
        "pestphp/pest-plugin-browser": "^4.1",
        "rector/rector": "^2.1 "
    },
    "repositories": {
        "andreamarelli/modular-forms": {
            "type": "vcs",
            "url": "https://github.com/andreamarelli/modular-forms"
        },
        "andreamarelli/imet-core": {
            "type": "path",
            "url": "./package/imet-core"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
          "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
          "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "php artisan ide-helper:generate",
            "php artisan ide-helper:meta",
            "php artisan log-viewer:publish"
        ],
        "phpstan": " ./vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit 512M",
        "rector": " ./vendor/bin/rector process",
        "pint": "./vendor/bin/pint --config pint.json",
        "fix": "composer rector && composer pint",
        "test": "./vendor/bin/pest"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
