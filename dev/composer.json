{
    "type": "project",
    "description": "Development environment for imet-core package",
    "require-dev": {
        "php": ">=8.4",
        "ext-pcntl": "*",
        "ext-sockets": "*",
        "ext-zip": "*",
        "barryvdh/laravel-ide-helper": "^3.8.0",
        "driftingly/rector-laravel": "^2.7.3",
        "fakerphp/faker": "^1.24.1",
        "fruitcake/laravel-debugbar": "^4.4.5",
        "imettool/imet-core": "*",
        "larastan/larastan": "^3.14",
        "laravel/framework": "^13.40",
        "laravel/pint": "^1.32.1",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "opcodesio/log-viewer": "^3.24.2",
        "pestphp/pest": "^5.3.5",
        "pestphp/pest-plugin-browser": "^5.2",
        "rector/rector": "^2.8.4 "
    },
    "repositories": {
        "akp/modular-forms": {
            "type": "vcs",
            "url": "https://code.europa.eu/akp/modular-forms"
        },
        "imettool/imet-core": {
            "type": "path",
            "url": "./package/imet-core"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
          "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
          "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "php artisan ide-helper:generate",
            "php artisan ide-helper:meta",
            "php artisan log-viewer:publish"
        ],
        "phpstan": " ./vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit 512M",
        "rector": " ./vendor/bin/rector process",
        "pint": "./vendor/bin/pint --config pint.json",
        "fix": "composer rector && composer pint",
        "test": "./vendor/bin/pest"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "gitlab-domains": ["code.europa.eu"]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
